<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 masks the icon. Keep the complete transparent logo inside
     its safe area instead of reusing the square legacy launcher artwork. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="288dp" android:height="288dp" android:gravity="center">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:width="160dp" android:height="138dp" android:gravity="center">
        <bitmap android:src="@drawable/orientia_splash"
            android:gravity="fill" android:filter="true" />
    </item>
</layer-list>
